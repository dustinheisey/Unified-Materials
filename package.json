{
  "name": "unified-materials",
  "license": "MIT",
  "private": "true",
  "author": "Inconvenient Dev",
  "type": "module",
  "version": "0.3.1",
  "scripts": {
    "format": "prettier . --write",
    "lint:types": "tsc --noEmit",
    "lint:scripts": "eslint --flag unstable_native_nodejs_ts_config  --config=eslint.config.ts . --fix",
    "clear": "cd src/main && rimraf resources",
    "lint": "npm run lint:types && npm run lint:scripts",
    "dev": "node --watch ./src/scripts/index.ts",
    "dev:clear": "npm run clear && node --watch ./src/scripts/index.ts",
    "build": "cd src/scripts && node ./index.ts",
    "build:clear": "npm run clear && cd src/scripts && node ./index.ts",
    "server": "./gradlew devServer"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "hytale-generators": "^0.3.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "type-fest": "^5.4.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
